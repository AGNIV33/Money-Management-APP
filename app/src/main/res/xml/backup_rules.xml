<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and below. Keep tokens and the local DB out of backups (ARCHITECTURE.md section 8). -->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="datastore" />
</full-backup-content>
